{
  "wifi": [
    { "ssid": "MyHomeNetwork", "psk": "my-wifi-password", "priority": 10 },
    { "ssid": "MobileHotspot", "psk": "hotspot-password", "priority": 3 }
  ],
  "bluetooth": {
    "speakers": [
      { "mac": "AA:BB:CC:DD:EE:FF", "name": "My BT Speaker", "priority": 1 }
    ]
  },
  "spotify": {
    "client_id": "your_spotify_client_id",
    "client_secret": "your_spotify_client_secret",
    "redirect_uri": "http://localhost:8888/callback",
    "device_name": "NFC-Box"
  },
  "behavior": {
    "pause_on_remove": false
  }
}
