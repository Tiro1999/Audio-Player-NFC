# Speaker auto-connect: keeps the preferred Bluetooth speaker connected and
# makes it the audio sink of the nfc-player PipeWire session.
[Unit]
Description=NFC player speaker auto-connect
After=bluetooth.target user@@NFC_UID@.service

[Service]
User=nfc-player
SupplementaryGroups=bluetooth
Environment=XDG_RUNTIME_DIR=/run/user/@NFC_UID@ PULSE_SERVER=unix:/run/user/@NFC_UID@/pulse/native
Environment=PYTHONPATH=/opt/nfc-player/current/src PYTHONUNBUFFERED=1
ExecStartPre=+/usr/sbin/rfkill unblock bluetooth
ExecStart=/opt/nfc-player/current/venv/bin/python -m nfc_player.bluetooth.autoconnect
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not hidden: the PipeWire socket lives under /run/user.
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/nfc-player

[Install]
WantedBy=multi-user.target
