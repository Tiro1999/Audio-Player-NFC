// NetworkManager access for the nfc-player service user only, so WiFi tags
// can add and switch profiles without sudo. Installed by wifi/setup.sh.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.wifi.scan"
    ];
    if (subject.user === "nfc-player" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
